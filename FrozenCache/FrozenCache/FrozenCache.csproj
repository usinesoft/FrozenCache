<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MessagePack" Version="3.1.7" />
    <PackageReference Include="Microsoft.AspNetCore.Hosting.WindowsServices" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.9" />
    <PackageReference Include="Serilog" Version="4.3.1" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FrozenCache.Server\FrozenCache.Server.csproj" />
    <ProjectReference Include="..\Messages\Messages.csproj" />
    <ProjectReference Include="..\PersistentStore\PersistentStore.csproj" />
  </ItemGroup>

  <!--
    Angular dashboard (../Dashboard), built with the server and shipped next to the executable in a "dashboard"
    folder, served at /dashboard (see Program.cs). Not wwwroot: the Web SDK treats wwwroot as static web assets,
    copied only on publish, while this server always serves from its own directory (the working directory is
    forced to it at startup, for Windows service hosting).
    Requires Node.js and npm; pass -p:SkipDashboard=true to build the server alone.
  -->
  <PropertyGroup>
    <DashboardDir>$(MSBuildProjectDirectory)\..\Dashboard</DashboardDir>
    <DashboardDistDir>$(DashboardDir)\dist\FrozenCacheDashboard\browser</DashboardDistDir>
  </PropertyGroup>

  <ItemGroup>
    <DashboardSources Include="$(DashboardDir)\src\**\*;$(DashboardDir)\public\**\*;$(DashboardDir)\package.json;$(DashboardDir)\package-lock.json;$(DashboardDir)\angular.json;$(DashboardDir)\tsconfig*.json" />
  </ItemGroup>

  <!-- Incremental: skipped when no dashboard source changed since the last Angular build. -->
  <Target Name="BuildDashboard" Condition="'$(SkipDashboard)' != 'true'" Inputs="@(DashboardSources)" Outputs="$(DashboardDistDir)\index.html">
    <Exec Command="npm ci" WorkingDirectory="$(DashboardDir)" Condition="!Exists('$(DashboardDir)\node_modules')" />
    <Exec Command="npm run build" WorkingDirectory="$(DashboardDir)" />
  </Target>

  <!-- Separate from BuildDashboard so that the files are included even when that target is skipped as up to date.
       Runs before AssignTargetPaths, so they take part in the normal copy to the output and publish directories. -->
  <Target Name="IncludeDashboard" BeforeTargets="AssignTargetPaths" DependsOnTargets="BuildDashboard" Condition="'$(SkipDashboard)' != 'true'">
    <!-- Two steps, with qualified metadata: an unqualified %(Filename) here would batch over the project's
         existing None items and copy those into the dashboard folder instead. -->
    <ItemGroup>
      <DashboardFiles Include="$(DashboardDistDir)\**\*" />
      <None Include="@(DashboardFiles)" Link="dashboard\%(DashboardFiles.RecursiveDir)%(DashboardFiles.Filename)%(DashboardFiles.Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>
